# Local Supabase: run npx supabase start, then use the URL and publishable/anon key it reports.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# No service-role key is used by the application. Admin membership is provisioned via SQL.
