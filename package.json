{
  "name": "padroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "node tests/database.mjs",
    "setup:local": "bash scripts/install-supabase.sh",
    "db:start": "bash scripts/prepare-vfs-postgres.sh && SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io .tools/supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:stop": ".tools/supabase stop",
    "db:reset": ".tools/supabase db reset --local",
    "env:local": "node scripts/configure-local.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs package.json",
    "screenshots:home": "node scripts/capture-homepage.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "geist": "^1.7.2",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
